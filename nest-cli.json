{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/follow-up/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/follow-up/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/follow-up",
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "file-uploads": {
      "type": "application",
      "root": "apps/file-uploads",
      "entryFile": "main",
      "sourceRoot": "apps/file-uploads/src",
      "compilerOptions": {
        "tsConfigPath": "apps/file-uploads/tsconfig.app.json"
      }
    },
    "follow-up": {
      "type": "application",
      "root": "apps/follow-up",
      "entryFile": "main",
      "sourceRoot": "apps/follow-up/src",
      "compilerOptions": {
        "tsConfigPath": "apps/follow-up/tsconfig.app.json"
      }
    },
    "follow-up-gateway": {
      "type": "application",
      "root": "apps/follow-up-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/follow-up-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/follow-up-gateway/tsconfig.app.json"
      }
    },
    "generate-report": {
      "type": "application",
      "root": "apps/generate-report",
      "entryFile": "main",
      "sourceRoot": "apps/generate-report/src",
      "compilerOptions": {
        "tsConfigPath": "apps/generate-report/tsconfig.app.json"
      }
    },
    "new-guest": {
      "type": "application",
      "root": "apps/new-guest",
      "entryFile": "main",
      "sourceRoot": "apps/new-guest/src",
      "compilerOptions": {
        "tsConfigPath": "apps/new-guest/tsconfig.app.json"
      }
    },
    "users": {
      "type": "application",
      "root": "apps/users",
      "entryFile": "main",
      "sourceRoot": "apps/users/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users/tsconfig.app.json"
      }
    }
  }
}